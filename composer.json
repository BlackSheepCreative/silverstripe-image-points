{
    "name": "blacksheepcreative/silverstripe-image-points",
    "description": "Plot points on an image.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "module"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ryan Potter",
            "email": "ryan.potter@littlegiant.co.nz",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/blacksheepcreative/silverstripe-image-points/issues"
    },
    "require": {
        "silverstripe/cms": "^6",
        "silverstripe/framework": "^6"
    },
    "autoload": {
        "psr-4": {
            "LittleGiant\\ImagePoints\\": "src/"
        }
    },
    "extra": {
        "installer-name": "silverstripe-image-points",
        "expose": [
            "client"
        ]
    },
    "require-dev": {
        "rector/rector": "^2.2",
        "phpstan/phpstan": "^2.1",
        "wernerkrauss/silverstripe-rector": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}